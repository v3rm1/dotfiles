# Private hosts (servers, tunnels) live in ~/.ssh/config.local, untracked.
Include ~/.ssh/config.local

Host *
    AddKeysToAgent yes
    # macOS-only option; ignored elsewhere instead of erroring
    IgnoreUnknown UseKeychain
    UseKeychain yes

Host github.com
    User v3rm1
    Hostname github.com
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/id_github
