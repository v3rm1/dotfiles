# Alias for common commands
alias cl='clear'

# Eza is better ls
alias ls="eza -l --icons=always --no-user --no-permissions"
alias lst="eza -l --tree --icons=always --no-user --no-permissions"
alias ct="bat"
alias n="nvim"
alias top="btop"
alias fz="fzf --height 40% --layout reverse"
alias cat="bat"
command -v dust &>/dev/null && alias du="dust -o si -D"
# Git shorthands live in ~/.config/zsh-abbr/user-abbreviations (zsh-abbr),
# so they expand inline and history keeps the full command.

# Filetype aliases to attach editors
alias -s txt=nvim
alias -s py=nvim
alias -s toml=nvim

# yay clear unused packages and dependencies
if command -v yay &>/dev/null; then
    # single quotes: list orphans when run, not once at shell startup
    alias cyay='yay -Rnscu $(yay -Qdtq)'
fi

# Refresh portfolio GoatCounter stats for the Obsidian HOME dashboard
alias portstats="python3 ~/Documents/projects/portfolio/scripts/analytics_report.py"

# vim: ft=sh

# kitty kittens: only when running directly in kitty (not inside tmux)
if [[ "$TERM" == "xterm-kitty" ]]; then
    # copies kitty terminfo and shell integration to the remote host
    alias ssh="kitten ssh"
fi
alias icat="kitten icat"
