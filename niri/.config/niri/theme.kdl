// Tokyo Night Night colours and cursor (formerly generated by DMS into dms/*.kdl).
// Cyberpunk accents: cyan #7dcfff to magenta #bb9af7 gradient on the focused window.

layout {
    background-color "transparent"

    focus-ring {
        active-color   "#7dcfff"
        active-gradient from="#7dcfff" to="#bb9af7" angle=45 relative-to="workspace-view" in="oklch shorter hue"
        inactive-color "#565f89"
        urgent-color   "#f7768e"
    }

    border {
        active-color   "#7dcfff"
        active-gradient from="#7dcfff" to="#bb9af7" angle=45 relative-to="workspace-view" in="oklch shorter hue"
        inactive-color "#565f89"
        urgent-color   "#f7768e"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#7aa2f7"
        inactive-color "#565f89"
        urgent-color   "#f7768e"
    }

    insert-hint {
        color "#7aa2f780"
    }
}

recent-windows {
    highlight {
        active-color   "#7dcfff"
        urgent-color   "#f7768e"
    }
}

cursor {
    xcursor-theme "Breeze_Hacked_Phosphor"
    xcursor-size 24
}

// Frosted glass behind Noctalia surfaces (needs niri 26.04+). Noctalia publishes its own
// blur regions, so only xray is turned off here (blur the windows behind, not just the
// wallpaper); forcing blur on would frost the whole full-screen panel surface.
blur {
    passes 3
    offset 4.0
    noise 0.03
    saturation 1.3
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}
