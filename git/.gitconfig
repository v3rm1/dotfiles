[user]
	name = v3rm1_UiA
	email = varun.ravi.varma@uia.no
[init]
	defaultBranch = main
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[pull]
	rebase = true
[rebase]
	autoStash = true
	updateRefs = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	algorithm = histogram
	colorMoved = default
	tool = kitty
[difftool]
	prompt = false
	trustExitCode = true
[difftool "kitty"]
	cmd = kitten diff \"$LOCAL\" \"$REMOTE\"
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[help]
	autocorrect = prompt

# Syntax-aware diffs on demand: `git dft` (diff), `git dlog` (log -p), `git dshow`.
# Plain `git diff` keeps the default pager so patches stay applyable.
[difftool]
	prompt = false
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[pager]
	difftool = true
[alias]
	dft = difftool --tool=difftastic
	dlog = -c diff.external=difft log --ext-diff -p
	dshow = -c diff.external=difft show --ext-diff

# Machine-specific settings (credential helper, signing keys) live here, untracked.
[include]
	path = ~/.gitconfig.local
