[user]
	name = v3rm1_UiA
	email = varun.ravi.varma@uia.no
[init]
	defaultBranch = main
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[pull]
	rebase = true
[rebase]
	autoStash = true
	updateRefs = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	algorithm = histogram
	colorMoved = default
	tool = kitty
[difftool]
	prompt = false
	trustExitCode = true
[difftool "kitty"]
	cmd = kitten diff \"$LOCAL\" \"$REMOTE\"
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[help]
	autocorrect = prompt

# Machine-specific settings (credential helper, signing keys) live here, untracked.
[include]
	path = ~/.gitconfig.local
