# Tokyo Night (night) for cmus. Uses terminal palette indices so colours
# follow kitty's tokyonight-night theme exactly.
set color_win_bg=default
set color_win_fg=default
set color_win_dir=4
set color_win_cur=6
set color_win_sel_bg=8
set color_win_sel_fg=15
set color_win_cur_sel_bg=8
set color_win_cur_sel_fg=6
set color_win_inactive_sel_bg=0
set color_win_inactive_sel_fg=7
set color_win_inactive_cur_sel_bg=0
set color_win_inactive_cur_sel_fg=6
set color_win_title_bg=0
set color_win_title_fg=5
set color_separator=8
set color_titleline_bg=0
set color_titleline_fg=4
set color_statusline_bg=0
set color_statusline_fg=7
set color_statusline_progress_bg=4
set color_statusline_progress_fg=0
set color_cmdline_bg=default
set color_cmdline_fg=default
set color_error=1
set color_info=3
